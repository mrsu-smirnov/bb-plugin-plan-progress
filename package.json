{
  "name": "bb-plugin-plan-progress",
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Plan Progress",
    "description": "Live progress bars above the message box: the agent plans stages and steps, and the bar fills as it works.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "description": "Live progress bars for agent tasks in BB, after zycck's plan-progress mod for Claude Code.",
  "license": "MIT",
  "author": "Yuri Smirnov (https://github.com/mrsu-smirnov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsu-smirnov/bb-plugin-plan-progress.git"
  },
  "homepage": "https://github.com/mrsu-smirnov/bb-plugin-plan-progress#readme",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "test:integration": "npm run build && node --test tests/integration/*.test.mjs",
    "typecheck": "tsc",
    "build": "bb plugin build",
    "test:ui": "node --experimental-strip-types --no-warnings --test tests/frontend/*.test.mjs"
  }
}
